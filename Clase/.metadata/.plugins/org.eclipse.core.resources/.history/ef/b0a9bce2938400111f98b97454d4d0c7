package com.escuela.dao;

import com.escuela.config.DatabaseConnection;
import com.escuela.modelos.Calificacion;
import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class CalificacionDAO {
    
    public boolean insertar(Calificacion calificacion) {
        String sql = "INSERT INTO calificaciones (estudiante_id, materia, nota) VALUES (?, ?, ?)";
        try (PreparedStatement pstmt = DatabaseConnection.getConnection().prepareStatement(sql)) {
            pstmt.setInt(1, calificacion.getEstudianteId());
            pstmt.setString(2, calificacion.getMateria());
            pstmt.setDouble(3, calificacion.getNota());
            return pstmt.executeUpdate() > 0;
        } catch (SQLException e) {
            System.err.println("Error al insertar calificación: " + e.getMessage());
            return false;
        }
    }
    
    public List<Calificacion> listarTodos() {
        List<Calificacion> lista = new ArrayList<>();
        String sql = "SELECT * FROM calificaciones";
        try (Statement stmt = DatabaseConnection.getConnection().createStatement();
             ResultSet rs = stmt.executeQuery(sql)) {
            while (rs.next()) {
                Calificacion c = new Calificacion();
                c.setId(rs.getInt("id"));
                c.setEstudianteId(rs.getInt("estudiante_id"));
                c.setMateria(rs.getString("materia"));
                c.setNota(rs.getDouble("nota"));
                lista.add(c);
            }
        } catch (SQLException e) {
            System.err.println("Error al listar calificaciones: " + e.getMessage());
        }
        return lista;
    }
    
    public Calificacion buscarPorId(int id) {
        String sql = "SELECT * FROM calificaciones WHERE id = ?";
        try (PreparedStatement pstmt = DatabaseConnection.getConnection().prepareStatement(sql)) {
            pstmt.setInt(1, id);
            ResultSet rs = pstmt.executeQuery();
            if (rs.next()) {
                Calificacion c = new Calificacion();
                c.setId(rs.getInt("id"));
                c.setEstudianteId(rs.getInt("estudiante_id"));
                c.setMateria(rs.getString("materia"));
                c.setNota(rs.getDouble("nota"));
                return c;
            }
        } catch (SQLException e) {
            System.err.println("Error al buscar calificación: " + e.getMessage());
        }
        return null;
    }
    
    public boolean actualizar(Calificacion calificacion) {
        String sql = "UPDATE calificaciones SET estudiante_id=?, materia=?, nota=? WHERE id=?";
        try (PreparedStatement pstmt = DatabaseConnection.getConnection().prepareStatement(sql)) {
            pstmt.setInt(1, calificacion.getEstudianteId());
            pstmt.setString(2, calificacion.getMateria());
            pstmt.setDouble(3, calificacion.getNota());
            pstmt.setInt(4, calificacion.getId());
            return pstmt.executeUpdate() > 0;
        } catch (SQLException e) {
            System.err.println("Error al actualizar calificación: " + e.getMessage());
            return false;
        }
    }
    
    public boolean eliminar(int id) {
        String sql = "DELETE FROM calificaciones WHERE id = ?";
        try (PreparedStatement pstmt = DatabaseConnection.getConnection().prepareStatement(sql)) {
            pstmt.setInt(1, id);
            return pstmt.executeUpdate() > 0;
        } catch (SQLException e) {
            System.err.println("Error al eliminar calificación: " + e.getMessage());
            return false;
        }
    }
}